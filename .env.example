# --- Telegram bot ---
TELEGRAM_API_TOKEN=123456789:AA...your-bot-token
SKIP_UPDATES=false
PARSE_MODE=HTML

# --- Optional custom Bot API server ---
# Set LOCAL=true to use http://localhost:8081, or TG_SERVER to a full base URL.
TG_SERVER=
LOCAL=false

# --- Proxy (honoured via aiohttp trust_env), e.g. socks5://127.0.0.1:1080 ---
PROXY=

# --- Debug / logging ---
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=UTC

# --- Access control (JSON-encoded lists) ---
ADMINS=["your_username"]
ADMINS_ID=[]
LANGUAGES=["ru", "en"]
# Chat id that receives error tracebacks from the error middleware (or leave empty)
DEVELOPER=

# --- Database (optional) ---
DATABASE=false
DATABASE_URL=sqlite:///database.sqlite

# --- Redis (optional). Set REDIS_URL directly, or REDIS_PASSWORD + host/port/db ---
REDIS_URL=
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Scheduler ---
ENABLE_APSCHEDULER=false
